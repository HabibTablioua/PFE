<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
			  name="TransactionHistoryReport" pageWidth="595" pageHeight="842" columnWidth="535"
			  leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="b1adf0f2-97dc-4a7b-8bcb-3cf4b82c1f75">

	<!-- Champs utilisés dans le rapport -->
	<field name="id" class="java.lang.Long"/>
	<field name="mti" class="java.lang.String"/>
	<field name="message" class="java.lang.String"/>
	<field name="format" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="createdAt" class="java.time.LocalDateTime"/>

	<!-- Titre du rapport -->
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="10" width="535" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[Transaction History Report]]></text>
			</staticText>
		</band>
	</title>

	<!-- En-têtes de colonnes -->
	<columnHeader>
		<band height="30">
			<textField>
				<reportElement x="0" y="5" width="50" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["ID"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="5" width="60" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["MTI"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="110" y="5" width="180" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Message"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="290" y="5" width="80" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Format"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="370" y="5" width="60" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Status"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="430" y="5" width="105" height="20"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Created At"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>

	<!-- Détails des données -->
	<detail>
		<band height="20">
			<textField>
				<reportElement x="0" y="0" width="50" height="20"/>
				<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="0" width="60" height="20"/>
				<textFieldExpression><![CDATA[$F{mti}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="110" y="0" width="180" height="20"/>
				<textFieldExpression><![CDATA[$F{message}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="290" y="0" width="80" height="20"/>
				<textFieldExpression><![CDATA[$F{format}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="370" y="0" width="60" height="20"/>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="430" y="0" width="105" height="20"/>
				<textFieldExpression><![CDATA[$F{createdAt}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

</jasperReport>
